# ============================================
# Smart Document Chatbot - Frontend Dockerfile
# Multi-stage build with nginx for production
# ============================================

# --- Stage 1: Build ---
FROM node:22-alpine AS build

WORKDIR /app

# Copy package files first to cache dependencies
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --silent 2>/dev/null || npm install --silent

# Copy source code
COPY frontend/ .

# Build args for environment configuration
ARG VITE_API_URL=/api

ENV VITE_API_URL=$VITE_API_URL

# Build production bundle
RUN npm run build

# --- Stage 2: Runtime ---
FROM nginx:1.29-alpine AS runtime

RUN apk upgrade --no-cache

# Add labels
LABEL maintainer="Smart Doc Chatbot Team"
LABEL description="Smart Document Chatbot - React Frontend"
LABEL version="1.0.0"

# Remove default nginx config
RUN rm -rf /etc/nginx/conf.d/default.conf
RUN sed -i 's#pid .*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf

# Copy Nginx template; the entrypoint renders the backend service address at startup.
COPY docker/nginx/nginx.conf.template /etc/nginx/templates/default.conf.template

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Create non-root user
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d /etc/nginx/templates

# Expose port
EXPOSE 8080
ENV BACKEND_UPSTREAM=backend:8080
ENV NGINX_ENVSUBST_FILTER=^BACKEND_UPSTREAM$

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/health || exit 1

USER nginx
CMD ["nginx", "-g", "daemon off;"]
