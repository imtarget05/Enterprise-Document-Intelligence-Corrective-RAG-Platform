# ============================================================================
# Smart Document Chatbot — Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env` (secret).
# Used by docker/docker-compose.yml (backend / llm-router / agent / airflow).
# CI fullstack/airflow jobs read these from GitHub repo Secrets.
# ============================================================================

# ---- Database (Neon serverless Postgres) ----
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
NEON_DATABASE_URL=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
NEON_POSTGRES_HOST=
POSTGRES_PORT=5432

# ---- Vector DB (Qdrant Cloud) ----
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_USE_HTTPS=false
QDRANT_API_KEY=

# ---- File storage (Cloudflare R2) ----
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=smart-doc-documents
R2_ENDPOINT=

# ---- LLM cloud fallback (CHỈ cho tài liệu PUBLIC — CONFIDENTIAL cấm) ----
# DEPLOYMENT CHỐT: cloud chỉ dùng khi classification=PUBLIC và local lỗi.
# CONFIDENTIAL + local lỗi -> 403, không bao giờ chạm các key dưới đây.
# ---- LLM (Cloudflare Workers AI via llm-router) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_TIMEOUT_SECONDS=60
LLM_ROUTER_PORT=8001
LLM_TOP_P=0.95  # top-p (nucleus) sampling used by the backend-and-router LLM calls

# ---- Secrets (fail-fast if empty in staging/prod) ----
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# ---- Web search (optional, Tavily) ----
TAVILY_API_KEY=

# ---- Agent service ----
AGENT_BASE_URL=http://agent:9000
AGENT_PORT=9000
COST_PER_1K_TOKENS={"@cf/meta/llama-3.3-70b-instruct-fp8-fast":0.0003,"@cf/baai/bge-base-en-v1.5":0.0001,"default":0.0003}
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHAT_SSE_THREADS=20

# ---- HITL approval store (agent service) ----
# auto: Redis when REDIS_URL is set, else in-memory (dev / single replica).
# Production (multi-replica / restart-safe) MUST set all three:
#   REDIS_URL + HITL_STORE_BACKEND=redis + HITL_FAIL_CLOSED=true
# so paused approvals survive restarts and every replica sees the same queue.
# Passwords must be URL-safe (no @ : / # ?). Point REDIS_URL at managed
# Redis (Upstash rediss://...) or at the compose redis below.
REDIS_URL=
REDIS_PASSWORD=
HITL_STORE_BACKEND=auto
HITL_FAIL_CLOSED=
HITL_REQUIRE_APPROVAL=true

# ---- Airflow (batch ingestion DAG) ----
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DB=airflow
AIRFLOW_PORT=8081
# Credentials the ingestion DAG uses to log into the backend:
AIRFLOW_INGEST_OWNER=airflow-bot
AIRFLOW_INGEST_USERNAME=airflow-bot
AIRFLOW_INGEST_PASSWORD=

# ---- Training-job orchestration (retrain DAG) ----
# External GPU runner that actually fine-tunes the LoRA adapter. Airflow and
# the agent service only submit + poll + validate; they never train in-process.
TRAINING_RUNNER_URL=
# Where the agent service persists training-job records (JSON, one file/job).
TRAINING_JOBS_DIR=agent/training_jobs
# Airflow Variable RETRAIN_TOKEN (X-Internal-Token) must equal the agent
# service INTERNAL_SERVICE_TOKEN for /v1/training-jobs calls to authenticate.

# ---- Frontend ----
VITE_API_URL=/api
FRONTEND_PORT=80

# ---- Backend ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=default
LOGGING_LEVEL_ROOT=INFO

# ============================================================================
# DEPLOYMENT CHỐT — Local-First (Hybrid by Classification)
# Mặc định: Ollama local + Qdrant local. Cloud fallback CHỈ cho PUBLIC.
# CONFIDENTIAL + local lỗi -> 403 policy_violation, KHÔNG đẩy cloud
# (xem llm-router/app/service.py::_active + docs/DEPLOYMENT_LOCAL_FIRST.md).
# Training duy nhất: colab/finetune_lora_T4.ipynb (LoRA Llama-3.2/Qwen).
# Reranker: pretrained bge-reranker-v2-m3 inference thuần (không finetune).
# ============================================================================

# ---- Local-First LLM (DEFAULT — LM Studio + Qdrant local) ----
# Ưu tiên local tier: LM Studio → Ollama → Cloudflare (PUBLIC only).
# LM Studio: mở app → tải qwen2.5-vl-3b-instruct +
# text-embedding-nomic-embed-text-v1.5 → Developer tab → Start Server.
# Id model phải khớp EXACT với `curl http://localhost:1234/v1/models`.
LOCAL_LMSTUDIO_URL=http://localhost:1234/v1
LOCAL_LMSTUDIO_MODEL=qwen2.5-vl-3b-instruct
LOCAL_LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LOCAL_LMSTUDIO_API_KEY=lm-studio
# LƯU Ý DIM: nomic=768. Đổi embed model = phải re-index Qdrant.

# ---- Local-First fallback (Ollama, khi LM Studio offline) ----
LOCAL_OLLAMA_URL=http://localhost:11434
#   make local-ollama-pull   # pulls qwen2.5:3b + nomic-embed-text (+ coder on demand)
# M1 Pro 16GB plan (2026-09-18): KEEP qwen2.5:3b (chat RAG default,
# num_ctx 4096, keep_alive 5m) + nomic-embed-text (kept so stored vectors
# stay valid). qwen2.5-coder:1.5b loads ONLY for task=code;
# qwen3-embedding:0.6b (~400MB) is the optional Vietnamese embedding upgrade
# (requires re-index). Run Ollama with OLLAMA_NUM_PARALLEL=1 and
# OLLAMA_MAX_LOADED_MODELS=1 to fit 16GB RAM.
LOCAL_OLLAMA_MODEL=qwen2.5:3b
LOCAL_OLLAMA_CODE_MODEL=qwen2.5-coder:1.5b
LOCAL_OLLAMA_EMBED_MODEL=nomic-embed-text
LOCAL_OLLAMA_NUM_CTX=4096
LOCAL_OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Giới hạn RAM M1 Pro 16GB: chỉ giữ 1 model trong RAM, unload sau 5m idle.
OLLAMA_KEEP_ALIVE=5m
# Seconds before a chat call to the local Ollama server times out (large
# prompts on CPU can take a while — keep generous).
LOCAL_OLLAMA_TIMEOUT_SECONDS=120
# Health-probe cache TTL (seconds): how long the router trusts a successful
# /api/tags probe before re-checking Ollama availability.
LOCAL_OLLAMA_HEALTH_TTL_SECONDS=10
