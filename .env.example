# SmartDocumentChatbot Cloudflare Workers AI Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_TIMEOUT_SECONDS=60.0
ROUTER_PROVIDER_OVERRIDE=cloudflare

# ── Production-required secrets (MUST be set via env var, never committed) ──
# Agent service internal auth — ≥32 characters, strong random value
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_STRONG_32CHAR_TOKEN

# PostgreSQL (long-term memory) — ≥12 characters
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_12CHAR_PASSWORD

# Qdrant — set only if your Qdrant cluster requires auth; leave empty for local unauthenticated Qdrant
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY_OR_LEAVE_EMPTY

# CORS — production origins only, NO localhost/127.0.0.1 in production
AGENT_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── Langfuse Observability (optional) ──
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_LANGFUSE_SECRET_KEY
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
