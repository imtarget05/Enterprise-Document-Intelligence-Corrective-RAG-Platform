# Smart Document Chatbot - Agent Service Configuration
# Copy this file to .env and fill in all values before deploying.
# NEVER commit .env with real secrets to version control.

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================
# Controls secret validation strictness. Set to "production" (or any value
# other than local/dev/development/test) for production deployments.
APP_ENV=production

# =============================================================================
# INTERNAL SERVICE AUTHENTICATION (REQUIRED)
# =============================================================================
# Must match the INTERNAL_SERVICE_TOKEN set in the Spring Boot backend.
# Generate with: openssl rand -base64 48
# Minimum 32 characters in production.
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_SECURE_RANDOM_TOKEN

# =============================================================================
# LLM ROUTER (Cloudflare Workers AI via LLM Router)
# =============================================================================
LLM_BASE_URL=http://llm-router:8000
LLM_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
LLM_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
LLM_TEMPERATURE=0.3

# =============================================================================
# LOCAL LLM OVERRIDES (optional - for local development)
# =============================================================================
# Uncomment and set to use local Ollama instead of cloud router
# LOCAL_OLLAMA_URL=http://localhost:11434
# LOCAL_OLLAMA_CHAT_MODEL=qwen2.5:3b
# LOCAL_OLLAMA_CODE_MODEL=qwen2.5-coder:1.5b
# LOCAL_OLLAMA_EMBED_MODEL=nomic-embed-text

# Uncomment and set to use local LM Studio instead of cloud router
# LOCAL_LMSTUDIO_URL=http://localhost:1234/v1
# LOCAL_LMSTUDIO_CHAT_MODEL=qwen2.5-vl-3b-instruct
# LOCAL_LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# LOCAL_LMSTUDIO_API_KEY=lm-studio

# =============================================================================
# QDRANT VECTOR DATABASE (REQUIRED)
# =============================================================================
# Qdrant Cloud free tier: https://cloud.qdrant.io
# QDRANT_API_KEY is optional for local unauthenticated Qdrant
QDRANT_HOST=your-qdrant-host
QDRANT_PORT=6333
QDRANT_USE_HTTPS=true
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY

# =============================================================================
# POSTGRESQL - LONG-TERM MEMORY (GraphMemory)
# =============================================================================
# Neon serverless PostgreSQL (free 512MB permanent): https://neon.tech
# These are used by GraphMemory for entity/relationship storage.
POSTGRES_HOST=your-neon-host
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=REPLACE_WITH_NEON_PASSWORD
# For Neon, set POSTGRES_SSLMODE=require
POSTGRES_SSLMODE=require

# =============================================================================
# POSTGRESQL - LANGGRAPH CHECKPOINTS (SHARED, DURABLE)
# =============================================================================
# CRITICAL for production: This enables shared checkpoints across replicas
# so paused HITL approvals survive restarts/redeploys.
# Provision a SEPARATE Neon database for checkpoints (or use the same one).
# Get the connection string from Neon dashboard and set as DATABASE_URL.
# Format: postgresql://user:password@host:port/db?sslmode=require
# The agent also accepts NEON_DATABASE_URL as an alias.
DATABASE_URL=postgresql://user:password@host:port/checkpoints_db?sslmode=require

# When true (default in production), the agent FAILS TO START if the
# shared Postgres checkpointer cannot be opened. This prevents silent
# downgrade to local SQLite which would lose paused HITL approvals.
LANGGRAPH_CHECKPOINT_SHARED_REQUIRED=true

# Local SQLite fallback (used when DATABASE_URL is not set or in test)
# LANGGRAPH_CHECKPOINT_DB=checkpoints.sqlite

# =============================================================================
# REDIS - HITL APPROVAL STORE + RATE LIMITING (REQUIRED FOR PRODUCTION)
# =============================================================================
# Upstash Redis (free tier): https://upstash.com
# Use rediss:// (TLS) for production. Format:
# REDIS_URL=rediss://:password@host:port/0
# For local development with docker-compose:
# REDIS_URL=redis://:password@redis:6379/0
REDIS_URL=REPLACE_WITH_REDIS_URL
HITL_STORE_BACKEND=redis
HITL_FAIL_CLOSED=true
HITL_REQUIRE_APPROVAL=true

# =============================================================================
# HUMAN-IN-THE-LOOP (HITL) SETTINGS
# =============================================================================
HITL_APPROVAL_TTL_SECONDS=3600

# =============================================================================
# WEB SEARCH (optional)
# =============================================================================
TAVILY_API_KEY=REPLACE_WITH_TAVILY_API_KEY

# =============================================================================
# GOOGLE WORKSPACE CONNECTORS (optional)
# =============================================================================
GOOGLE_CREDENTIALS_JSON=REPLACE_WITH_PATH_OR_INLINE_JSON
GOOGLE_TOKEN_JSON=REPLACE_WITH_PATH_OR_INLINE_JSON

# =============================================================================
# SLACK CONNECTOR (optional)
# =============================================================================
SLACK_BOT_TOKEN=REPLACE_WITH_SLACK_BOT_TOKEN

# =============================================================================
# MICROSOFT SHAREPOINT / GRAPH (optional)
# =============================================================================
SHAREPOINT_MOCK_ENABLED=true
MICROSOFT_GRAPH_TOKEN=REPLACE_WITH_MICROSOFT_GRAPH_TOKEN
SHAREPOINT_SITE_ID=REPLACE_WITH_SITE_ID
SHAREPOINT_DRIVE_ID=REPLACE_WITH_DRIVE_ID

# =============================================================================
# EMAIL / SMTP (optional - for report agent)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# =============================================================================
# JIRA / NOTION / TEAMS INTEGRATIONS (optional)
# =============================================================================
JIRA_BASE_URL=REPLACE_WITH_JIRA_BASE_URL
JIRA_EMAIL=REPLACE_WITH_JIRA_EMAIL
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN
NOTION_API_TOKEN=REPLACE_WITH_NOTION_API_TOKEN
TEAMS_WEBHOOK_URL=REPLACE_WITH_TEAMS_WEBHOOK_URL

# =============================================================================
# COST TRACKING (optional)
# =============================================================================
# JSON map: model -> price per 1k tokens (USD)
COST_PER_1K_TOKENS='{"@cf/meta/llama-3.3-70b-instruct-fp8-fast":0.0003,"@cf/baai/bge-base-en-v1.5":0.0001,"default":0.0003}'

# =============================================================================
# CORS (REQUIRED FOR PRODUCTION)
# =============================================================================
# Comma-separated list of origins allowed to call this service from a browser.
# In production, MUST be set explicitly and must NOT contain localhost.
AGENT_ALLOWED_ORIGINS=https://your-frontend-domain.com

# =============================================================================
# RATE LIMITING
# =============================================================================
AGENT_RATE_LIMIT_RPM=20
AGENT_MAX_REQUEST_BYTES=524288

# =============================================================================
# SERVER PORT
# =============================================================================
AGENT_PORT=9000

# =============================================================================
# PROMETHEUS METRICS
# =============================================================================
PROMETHEUS_ENABLED=true

# =============================================================================
# RERANKER MODEL (optional - CrossEncoder for re-ranking)
# =============================================================================
# Leave empty to disable (CrossEncoder OOMs on free 512Mi instances)
RERANKER_MODEL=

# =============================================================================
# BACKEND URL (for ADK runtime)
# =============================================================================
BACKEND_URL=http://backend:8080